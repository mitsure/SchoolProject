# cp .env.example .env の後、公開前に認証情報を必ず変更してください。
SPORTDENT_USERNAME=admin
SPORTDENT_PASSWORD=change-this-before-publication
SPORTDENT_SESSION_SECRET=replace-with-a-long-random-value
SPORTDENT_EXTRACTOR=ollama
SPORTDENT_OLLAMA_MODEL=qwen3:8b
# 研究用：固定したモデルの実際のダイジェスト等を記録（任意、未指定は版未記録）
SPORTDENT_OLLAMA_MODEL_REVISION=
SPORTDENT_HOST=127.0.0.1
SPORTDENT_PORT=8000
SPORTDENT_RELOAD=0
